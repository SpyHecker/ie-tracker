{
  "name": "ie-tracker",
  "version": "1.0.0",
  "description": "Flow — MERN income & expense tracker",
  "main": "server/src/server.js",
  "scripts": {
    "start": "npm run build && node server/src/server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node server/src/server.js",
    "client:dev": "vite --config client/vite.config.js",
    "client:build": "vite build --config client/vite.config.js",
    "client:preview": "vite preview --config client/vite.config.js",
    "build": "npm run client:build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.11.0",
    "mongoose": "^8.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "vite": "^5.4.19"
  }
}
